{
  "name": "adn-ui",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "description": "High-quality, styled React UI components built with Base UI and Tailwind CSS v4",
  "homepage": "https://github.com/awaiden/adn-ui#readme",
  "bugs": {
    "url": "https://github.com/awaiden/adn-ui/issues"
  },
  "license": "MIT",
  "author": "Halil Aydın <https://github.com/awaiden>",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaiden/adn-ui.git"
  },
  "scripts": {
    "build": "next build",
    "build-storybook": "storybook build",
    "build:registry": "npx shadcn build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "dev": "node node_modules/next/dist/bin/next dev",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "husky",
    "start": "next start",
    "storybook": "BROWSER=none storybook dev -p 6006",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "chromatic": "^18.7.1",
    "cnfast": "^0.1.0",
    "fumadocs-core": "16.15.4",
    "fumadocs-mdx": "15.4.0",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.4",
    "lucide-react": "^1.35.0",
    "next": "16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-variants": "^3.3.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "mcp-handler": "^2.1.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "happy-dom": "^20.11.13",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.26",
    "postcss-tw-auto-reference": "^0.1.1",
    "storybook": "10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt --write"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
